{
  "name": "@depot/cli",
  "version": "1.0.0",
  "description": "depot CLI",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rimraf dist",
    "start": "node ./dist/index.js",
    "test": "vitest run",
    "dev": "tsc -b --watch",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint": "tsc -b && prettier --check \"src/**/*.{js,jsx,ts,tsx}\"",
    "typecheck": "tsc -b"
  },
  "author": "Francois Laubscher",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.13.3",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@depot/core": "workspace:*",
    "node-html-parser": "^9.0.1"
  }
}
