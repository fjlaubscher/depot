{
  "name": "@depot/core",
  "version": "1.0.0",
  "description": "Shared core functionality and types for depot packages",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./utils/slug": {
      "types": "./dist/utils/slug.d.ts",
      "import": "./dist/utils/slug.js",
      "default": "./dist/utils/slug.js"
    },
    "./utils/wargear": {
      "types": "./dist/utils/wargear.d.ts",
      "import": "./dist/utils/wargear.js",
      "default": "./dist/utils/wargear.js"
    },
    "./utils/abilities": {
      "types": "./dist/utils/abilities.d.ts",
      "import": "./dist/utils/abilities.js",
      "default": "./dist/utils/abilities.js"
    },
    "./utils/roster": {
      "types": "./dist/utils/roster.d.ts",
      "import": "./dist/utils/roster.js",
      "default": "./dist/utils/roster.js"
    },
    "./utils/collection": {
      "types": "./dist/utils/collection.d.ts",
      "import": "./dist/utils/collection.js",
      "default": "./dist/utils/collection.js"
    },
    "./utils/common": {
      "types": "./dist/utils/common.d.ts",
      "import": "./dist/utils/common.js",
      "default": "./dist/utils/common.js"
    },
    "./utils/datasheets": {
      "types": "./dist/utils/datasheets.d.ts",
      "import": "./dist/utils/datasheets.js",
      "default": "./dist/utils/datasheets.js"
    },
    "./utils/rebind": {
      "types": "./dist/utils/rebind.d.ts",
      "import": "./dist/utils/rebind.js",
      "default": "./dist/utils/rebind.js"
    },
    "./utils/detachments": {
      "types": "./dist/utils/detachments.d.ts",
      "import": "./dist/utils/detachments.js",
      "default": "./dist/utils/detachments.js"
    },
    "./utils/roster-legality": {
      "types": "./dist/utils/roster-legality.d.ts",
      "import": "./dist/utils/roster-legality.js",
      "default": "./dist/utils/roster-legality.js"
    },
    "./utils/model-costs": {
      "types": "./dist/utils/model-costs.d.ts",
      "import": "./dist/utils/model-costs.js",
      "default": "./dist/utils/model-costs.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rimraf dist",
    "dev": "tsc -b --watch",
    "test": "vitest run",
    "prepublishOnly": "pnpm run clean && pnpm run build",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint": "tsc --noEmit && prettier --check \"src/**/*.{js,jsx,ts,tsx}\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "author": "Francois Laubscher",
  "license": "MIT"
}
