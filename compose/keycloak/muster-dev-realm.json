{
  "realm": "muster-dev",
  "enabled": true,
  "sslRequired": "none",
  "defaultSignatureAlgorithm": "RS256",
  "clientScopes": [
    {
      "name": "muster-api",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "subject",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": { "access.token.claim": "true" }
        },
        {
          "name": "muster-sync-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "muster-sync",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "muster-sync",
      "protocol": "openid-connect",
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "muster-web",
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": ["http://localhost:8788/auth/callback"],
      "webOrigins": ["http://localhost:8788"],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "defaultClientScopes": ["muster-api"]
    },
    {
      "clientId": "muster-check",
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "defaultClientScopes": ["muster-api"]
    }
  ],
  "users": [
    {
      "id": "11111111-1111-4111-8111-111111111111",
      "username": "alice",
      "firstName": "Alice",
      "lastName": "Development",
      "email": "alice@example.test",
      "enabled": true,
      "requiredActions": [],
      "credentials": [{ "type": "password", "value": "alice-dev-only", "temporary": false }]
    },
    {
      "id": "22222222-2222-4222-8222-222222222222",
      "username": "bob",
      "firstName": "Bob",
      "lastName": "Development",
      "email": "bob@example.test",
      "enabled": true,
      "requiredActions": [],
      "credentials": [{ "type": "password", "value": "bob-dev-only", "temporary": false }]
    }
  ]
}
